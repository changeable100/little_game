+    r3_bend_t invalid=*b;
+    r3_world_t invalid_world=*w;
+    invalid_world.bend=&invalid;
+    invalid.sweep_axis=invalid.radial_start;
+    CHECK(r3_world_validate(&invalid_world)==R3_INVALID);
+    return true;
+}
