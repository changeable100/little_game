+            float r=b->radius+side*b->half_width;
+            CHECK(near(r3_bend_height(b,c,0,r),z,.001f));
+            r3_vec_t point=r3_bend_point(b,c,0,r,z);
+            CHECK(top_point(&w->boxes[5+end],point,1));
