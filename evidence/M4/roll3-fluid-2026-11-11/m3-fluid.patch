+            double before=(now()-t)/rounds;t=now();
+            for(unsigned k=0;k<rounds;++k)assert(roll3_renderer_render_play(new_color,new_depth+1,100,&s,w,NULL)==0);
+            double after=(now()-t)/rounds;
